# Копирайте като .env.local и попълнете. Никога не качвайте тайни в git.
DATABASE_URL=postgres://matchora:matchora_dev@localhost:5433/matchora
APP_URL=http://localhost:3000
# Имейли: без SMTP_URL писмата се записват в email_outbox и в конзолата (само за разработка).
SMTP_URL=
MAIL_FROM="Matchora <no-reply@matchora.example>"
# Плащания: "mock" е само за разработка/демо. В продукция е нужен реален доставчик и таен ключ за подписа на webhook.
PAYMENT_PROVIDER=mock
WEBHOOK_SECRET=dev-webhook-secret-change-me

# Тайна за шифроване на 2FA секретите (AES-256-GCM). ЗАДЪЛЖИТЕЛНА в продукция: поне 32 случайни символа.
# Генериране: openssl rand -hex 32   (ВНИМАНИЕ: при смяна съществуващите 2FA настройки спират да работят)
APP_SECRET=
# Bearer токен за /api/cron/mail (повторен опит за неизпратени писма). Генериране: openssl rand -hex 24
CRON_SECRET=
# Stripe (PAYMENT_PROVIDER=stripe): секретен ключ и подписваща тайна на webhook endpoint-а <APP_URL>/api/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
